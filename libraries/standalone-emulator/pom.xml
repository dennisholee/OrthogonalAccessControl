<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.oac</groupId>
    <artifactId>orthogonal-access-control</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>oac-standalone-emulator</artifactId>
  <name>OAC Standalone Emulator Library</name>
  <description>In-memory adapters and Spring configuration for running the PDP decision engine without MongoDB. Zero middleware dependencies — Java 17+ only.</description>

  <dependencies>
    <!-- PDP decision engine (the real rule chain + SpEL evaluator) -->
    <dependency>
      <groupId>com.oac</groupId>
      <artifactId>policy-decision-service</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Spring Boot autoconfiguration support -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-logging</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Jackson for JSON serialization -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>